# Salin menjadi .env lalu isi token dari dasbor Cloudflare Zero Trust (Networks > Tunnels).
# Jangan commit file .env.
TUNNEL_TOKEN=

# Port di host server. Ganti bila sudah dipakai container lain.
ARKANA_PORT=18080

# Kode undangan untuk mendaftar akun. Kosongkan bila siapa pun yang tahu alamat game boleh mendaftar.
ARKANA_INVITE=

# Pengirim email untuk "lupa kata sandi", lewat SMTP penyedia email. Kosongkan SMTP_HOST untuk mematikan.
# SMTP_PASS adalah rahasia: hanya di file .env ini, jangan di chat atau git.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Arkana <alamat@domainmu>
