# Salin menjadi .env lalu isi token dari dasbor Cloudflare Zero Trust (Networks > Tunnels).
# Jangan commit file .env.
TUNNEL_TOKEN=

# Port di host server. Ganti bila sudah dipakai container lain.
ARKANA_PORT=18080

# Kode undangan untuk mendaftar akun. Kosongkan bila siapa pun yang tahu alamat game boleh mendaftar.
ARKANA_INVITE=
